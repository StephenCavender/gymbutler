<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ description or 'GymButler - Your all-in-one gym companion for calculating percentages, converting weights, and timing your workouts' }}" />
    <title>{% if title %}{{ title }} | {% endif %}Gym Butler</title>
    <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
    <style>
      * {
        box-sizing: border-box;
      }
      html {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #0f0f0f;
        color: #fff;
        line-height: 1.6;
      }
      body {
        margin: 0;
        padding: 1.5rem;
        max-width: 60ch;
        margin: 0 auto;
      }
      a {
        color: #fc9a2e;
        text-decoration: none;
        transition: opacity 0.3s ease;
      }
      a:hover {
        opacity: 0.8;
      }
      h1, h2, h3 {
        line-height: 1.2;
      }
      .header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
      }
      .logo {
        width: 50px;
        height: 50px;
      }
      .title {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 0;
        background: linear-gradient(135deg, #fc9a2e, #e40b3f);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .download-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin: 2rem 0;
      }
      .download-buttons img {
        height: 50px;
      }
      .footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid #333;
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        align-items: center;
        font-size: 0.875rem;
      }
      .footer a {
        color: #fff;
      }
      .prose {
        max-width: 65ch;
      }
      .prose h2 {
        margin-top: 2rem;
        color: #fc9a2e;
      }
      .prose p {
        margin-bottom: 1rem;
      }
      .back-link {
        display: inline-block;
        margin-bottom: 1rem;
        color: #666;
      }
      .features {
        display: grid;
        gap: 1.5rem;
        margin: 2rem 0;
      }
      .feature {
        background: #1a1a1a;
        padding: 1.5rem;
        border-radius: 8px;
      }
      .feature h3 {
        margin: 0 0 0.5rem 0;
        color: #fc9a2e;
      }
      .feature p {
        margin: 0;
        color: #aaa;
      }
      .nav {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
      }
      .nav a {
        color: #666;
        font-size: 0.875rem;
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/">Home</a>
      <a href="/terms/">Terms</a>
      <a href="/privacy/">Privacy</a>
    </nav>
    {{ content | safe }}
    <footer class="footer">
      <a href="/terms/">Terms & Conditions</a>
      <a href="/privacy/">Privacy</a>
      <a href="https://cavender.io">© Stephen Cavender</a>
    </footer>
  </body>
</html>